/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://res.cloudinary.com; frame-src https://www.youtube-nocookie.com; script-src 'self'; style-src 'self'; font-src 'self'; connect-src 'self' https://api.staticforms.dev; form-action 'self' https://api.staticforms.dev; base-uri 'self'; frame-ancestors 'none'; upgrade-insecure-requests

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: public, max-age=3600

/script.js
  Cache-Control: public, max-age=3600
